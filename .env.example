# Copy to .env and fill in. Every value is optional: with nothing set, Mandate runs
# fully offline (simulated PayPal + built-in planner) so you can try the whole flow.

# --- PayPal SANDBOX credentials (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only needed to receive PayPal webhooks (see README). Without it the webhook endpoint stays disabled.
PAYPAL_WEBHOOK_ID=

# --- AI (Claude via the Anthropic API). Without a key a rule-based planner is used. ---
ANTHROPIC_API_KEY=
MANDATE_MODEL=claude-sonnet-5-5

# --- Server ---
PORT=3000
HOST=127.0.0.1
# If set, the agent-to-agent endpoint requires "Authorization: Bearer <key>"
MANDATE_A2A_KEY=
